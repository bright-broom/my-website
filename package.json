{
  "name": "toshiki-sakuta-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:design": "tsx scripts/check-design.ts",
    "test:visual": "playwright test",
    "test:visual:baseline": "playwright test --update-snapshots=all",
    "check:types": "tsc --noEmit",
    "check:deadcode": "knip",
    "check": "npm run check:types && npm run check:design && npm run check:deadcode",
    "test:behavior": "playwright test --grep @behavior"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.6",
    "next": "^15.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "autoprefixer": "^10.0.1",
    "knip": "6.35.1",
    "postcss": "8.5.28",
    "tailwindcss": "^3.3.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
